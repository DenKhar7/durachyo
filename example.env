# Скопируй в .env и заполни. НИКОГДА не коммить настоящий .env
BOT_TOKEN=123456:replace-me

# id групп через запятую. Пусто = бот выходит из любой группы (id видно в логах)
ALLOWED_CHAT_IDS=
# твой user_id (и друзей-админов) через запятую. Узнать: @userinfobot
ADMIN_IDS=

# слова, на которые бот откликается всегда
TRIGGER_WORDS=сглыпа,сглыпка

MAX_MESSAGES_PER_CHAT=10000
# 1 = бред, 2 = полусвязно, 3 = почти цитаты
MARKOV_ORDER=2
# шанс (в %) влезть в разговор без упоминания
DEFAULT_REPLY_CHANCE=5

COMMAND_COOLDOWN=3
REPLY_COOLDOWN=2
ALL_COOLDOWN=300
LOG_LEVEL=INFO
