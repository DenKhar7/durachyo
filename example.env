# Скопируй в .env и заполни. НИКОГДА не коммить настоящий .env
BOT_TOKEN=123456:replace-me

# id групп через запятую. Пусто = бот выходит из любой группы (id видно в логах)
ALLOWED_CHAT_IDS=
# твой user_id (и друзей-админов) через запятую. Узнать: @userinfobot
ADMIN_IDS=

# слова, на которые бот откликается всегда
TRIGGER_WORDS=сглыпа,сглыпка

MAX_MESSAGES_PER_CHAT=10000
# 1 = бред, 2 = полусвязно, 3 = почти цитаты
MARKOV_ORDER=2
# базовая болтливость (в %). Бот сам корректирует: молчит сразу после своего ответа,
# чаще лезет на вопросы, капс и ярлыки, всегда отвечает, если позвали. /chance в чате
DEFAULT_REPLY_CHANCE=40
# шанс (в %) подколоть ярлыком из /tag, если в сообщении есть это имя
TAG_CHANCE=60
# шанс (в %) пингануть кого-то из чата в конце ответа
PING_CHANCE=6
# шанс (в %) ответить, когда позвали по имени / реплаем. Не 100: игнорить тоже характер
CALLED_CHANCE=80
# шанс (в %) поставить реакцию на сообщение (на смех и медиа вдвое чаще)
REACTION_CHANCE=5
# шанс (в %) подколоть, когда в чате упомянули кого-то из своих (bot/nicknames.py)
NICK_CHANCE=50
# коронные фразы через запятую. Пусто = своих коронок нет, вырастут из смеха
CATCHPHRASES=normalno,normalno davai
# через сколько часов тишины бот сам напишет в чат (0 = никогда)
REVIVE_AFTER_HOURS=4
# когда не будить чат (часы по TIMEZONE)
QUIET_HOURS=1-10
TIMEZONE=Europe/Moscow

COMMAND_COOLDOWN=3
REPLY_COOLDOWN=2
ALL_COOLDOWN=300
# сколько дуэлей в минуту можно в одном чате
DUELS_PER_MINUTE=5
LOG_LEVEL=INFO
